# Local .terraform directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
**/builds/
*.csv
# Crash log files
crash.log

# CLI configuration files
.terraformrc
terraform.rc

# Sensitive variable files
*.tfvars
*.tfvars.json
secrets.auto.tfvars

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files
*.tfplan

# Terraform lock file (optional to ignore)
# .terraform.lock.hcl

# Ignore backup files
*.bak

# Editor & OS specific files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.log
